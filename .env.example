# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web Client Configuration (Optional overrides if not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Firebase App Check & Cloud Functions Runtime Flags (Client-safe)
VITE_FIREBASE_APP_CHECK_SITE_KEY=""
VITE_FIREBASE_FUNCTIONS_REGION="us-central1"
VITE_USE_CLOUD_FUNCTIONS="false"
VITE_USE_FIREBASE_EMULATORS="false"

# Server-Side Cloud Functions Secrets (Configure via `firebase functions:secrets:set` - NEVER prefix with VITE_)
SUPER_ADMIN_BOOTSTRAP_SECRET=""
SUPER_ADMIN_BOOTSTRAP_EMAIL="rexon.smc@gmail.com"

